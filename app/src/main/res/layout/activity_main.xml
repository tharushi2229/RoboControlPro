<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".MainActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mainViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#1A2B2E"
        app:cardCornerRadius="35dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/mainBottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5"
            android:paddingHorizontal="12dp">

            <!-- 1. Shop Tab -->
            <ImageView
                android:id="@+id/tabMainShop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:padding="12dp"
                android:src="@drawable/icon_shop"
                app:tint="#80FFFFFF" />

            <!-- 2. Community Tab -->
            <ImageView
                android:id="@+id/tabMainCommunity"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:padding="12dp"
                android:src="@drawable/icon_community"
                app:tint="#80FFFFFF" />

            <!-- 3. Home Tab -->
            <ImageView
                android:id="@+id/tabMainHome"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:padding="12dp"
                android:src="@drawable/icon_home"
                app:tint="#80FFFFFF" />

            <!-- 4. Learning Tab -->
            <ImageView
                android:id="@+id/tabMainLearning"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:padding="12dp"
                android:src="@drawable/icon_learning"
                app:tint="#80FFFFFF" />

            <!-- 5. Joystick Tab -->
            <ImageView
                android:id="@+id/tabMainJoystick"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:padding="12dp"
                android:src="@drawable/icon_joystick"
                app:tint="#80FFFFFF" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>