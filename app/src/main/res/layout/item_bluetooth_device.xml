<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#0D1C1E"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Bluetooth අයිකනය -->
        <ImageView
            android:id="@+id/imgDeviceIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/stat_sys_data_bluetooth"
            app:tint="#17C3B2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- උපාංගයේ නම (උදා: HC-05) -->
        <TextView
            android:id="@+id/txtDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="HC-05 / Arduino"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imgDeviceIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnConnectDevice" />

        <!-- උපාංගයේ MAC ලිපිනය -->
        <TextView
            android:id="@+id/txtMacAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="00:11:22:33:44:55"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/imgDeviceIcon"
            app:layout_constraintTop_toBottomOf="@id/txtDeviceName"
            app:layout_constraintEnd_toStartOf="@id/btnConnectDevice" />

        <!-- Connect බොත්තම -->
        <Button
            android:id="@+id/btnConnectDevice"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Connect"
            android:textColor="#000000"
            android:backgroundTint="#00FF00"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>