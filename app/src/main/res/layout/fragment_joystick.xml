<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121e1f"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="120dp">

        <!-- 1. Header: Avatar and Title -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/avatarImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profile" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Arduino Control"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 2. Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Control your Arduino projects remotely"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <!-- 3. Connection Status Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/statusBadgeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1A2B2E"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">
                <ImageView
                    android:id="@+id/wifiIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="#17C3B2"
                    android:contentDescription="Wifi Status" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/wifiIcon"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:text="Connection status"
                    android:textColor="#FFFFFF" />
                <Button
                    android:id="@+id/btnConnected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:backgroundTint="#17C3B2"
                    android:text="Connected"
                    android:textColor="#000000" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Mode Selector Bar (Now under connection status) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1A2B2E"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="4"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/btnLights"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_lights"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Lights" />

                <ImageView
                    android:id="@+id/btnVehicle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_vehicle"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Vehicle" />

                <ImageView
                    android:id="@+id/btnRobot"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_robot"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Robot" />

                <ImageView
                    android:id="@+id/btnTerminal"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_terminal"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Terminal" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. Content Containers -->
        <LinearLayout
            android:id="@+id/ledContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/projectListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A2B2E"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📂 LED Projects"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                            <ImageView
                                android:id="@+id/btnProjectGuide"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_learning"
                                app:tint="#FFFFFF"
                                android:layout_marginEnd="16dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Project Guide"
                                android:clickable="true"
                                android:focusable="true"/>
                            <ImageView
                                android:id="@+id/btnDeleteProject"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_delete"
                                app:tint="#FF5252"
                                android:layout_marginEnd="16dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Delete Project" />
                            <ImageView
                                android:id="@+id/btnAddProject"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_input_add"
                                app:tint="#FFFFFF"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Add Project" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33FFFFFF"
                            android:layout_marginVertical="12dp"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/projectRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/projectDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnBackToProjects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="#17C3B2"
                        android:contentDescription="Back" />
                    <TextView
                        android:id="@+id/txtCurrentProjectTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Project Name"
                        android:textColor="#17C3B2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A2B2E"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="💡 LED Control"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                            <ImageView
                                android:id="@+id/btnLedGuide"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_learning"
                                app:tint="#FFFFFF"
                                android:layout_marginEnd="16dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Guide"
                                android:clickable="true"
                                android:focusable="true" />
                            <ImageView
                                android:id="@+id/btnDeleteLed"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_delete"
                                app:tint="#FF5252"
                                android:layout_marginEnd="16dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Delete LED" />
                            <ImageView
                                android:id="@+id/btnAddLed"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_input_add"
                                app:tint="#FFFFFF"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Add LED" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33FFFFFF"
                            android:layout_marginVertical="12dp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/ledRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A2B2E"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RGB LED Control"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchRgb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">
                            <ImageView
                                android:id="@+id/imgColorWheel"
                                android:layout_width="220dp"
                                android:layout_height="220dp"
                                android:src="@drawable/color_wheel"
                                android:scaleType="fitCenter"
                                android:contentDescription="Color Wheel" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Selected Color: "
                                    android:textColor="#80FFFFFF"/>
                                <View
                                    android:id="@+id/colorPreview"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="8dp"
                                    android:background="#FFFFFF"/>
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/sliderBrightness"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="255"
                                android:progress="255"
                                android:layout_marginTop="24dp"
                                android:layout_marginBottom="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <!-- 6. Vehicle Container -->
        <LinearLayout
            android:id="@+id/vehicleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTruck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A2B2E"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/imgTruck"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_truck"
                    android:padding="16dp"
                    android:contentDescription="Truck" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A2B2E"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/imgCar"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_car"
                    android:padding="16dp"
                    android:contentDescription="Car" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- 7. Robot Container -->
        <LinearLayout
            android:id="@+id/botContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="20dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Robot Controls Comming Soon..."
                android:textColor="#80FFFFFF"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 8. Terminal Container -->
        <LinearLayout
            android:id="@+id/terminalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terminal"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/btnHelp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_help"
                    app:tint="#17C3B2"
                    android:layout_toStartOf="@id/btnClear"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="20dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Help" />
                <ImageView
                    android:id="@+id/btnClear"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#17C3B2"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear Terminal" />
            </RelativeLayout>

            <ScrollView
                android:id="@+id/terminalScrollView"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:padding="16dp"
                android:nestedScrollingEnabled="true">
                <TextView
                    android:id="@+id/txtTerminalLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&lt; Hello World\n&gt; Hello\n\nTerminal data...\nTerminal data...\nTerminal data...\nTerminal data...\nTerminal data...\nTerminal data...\nTerminal data...\nTerminal data...\nTerminal data...█"
                    android:textColor="#17C3B2"
                    android:textSize="14sp"
                    android:typeface="monospace"/>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_terminal_input"
                    android:orientation="horizontal"
                    android:padding="4dp"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etTerminalInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Send message..."
                        android:textColorHint="#80FFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="@null"
                        android:padding="12dp"
                        android:singleLine="true"/>
                    <ImageView
                        android:id="@+id/btnTerminalSend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="#17C3B2"
                        android:layout_marginEnd="12dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Send Command" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnTerminalSettings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="#17C3B2"
                    android:layout_marginStart="16dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
