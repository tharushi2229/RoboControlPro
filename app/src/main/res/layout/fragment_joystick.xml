<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:ignore="HardcodedText">

    <!-- ඉහළ වම් කෙළවරේ ඇති Profile (පැතිකඩ) අයිකනය (සුදු පාට tint එක එකතු කර ඇත) -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/ic_new_profile_pic"
        android:contentDescription="Profile Icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#FFFFFF" />

    <!-- ප්‍රධාන මාතෘකාව (Main Title) -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Arduino Control"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- උප මාතෘකාව (Subtitle) -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Control your Arduino projects remotely"
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        tools:ignore="TextContrastCheck"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Connection Status (සම්බන්ධතා තත්ත්වය) පෙන්වන කොටස -->
    <androidx.cardview.widget.CardView
        android:id="@+id/connectionStatusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#1A2B2E"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- WiFi අයිකනය -->
            <ImageView
                android:id="@+id/imgWifi"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wifi"
                android:contentDescription="WiFi Status Icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="#00FF00"/>

            <!-- "Connection status" අකුරු -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Connection status"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgWifi"
                app:layout_constraintEnd_toStartOf="@id/statusBadgeCard" />

            <!-- "Connected" (සම්බන්ධයි) පෙන්වන කොළ පාට කොටස -->
            <androidx.cardview.widget.CardView
                android:id="@+id/statusBadgeCard"
                android:layout_width="105dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#00FF00"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnDisconnect">

                <TextView
                    android:id="@+id/txtConnected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Connected"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- "Disconnect" බොත්තම -->
            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="105dp"
                android:layout_height="38dp"
                android:padding="0dp"
                android:text="Disconnect"
                android:textColor="#17C3B2"
                android:backgroundTint="#0D1C1E"
                android:textSize="11sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- උප මෙනුව (Lights, Vehicle, Robot, Terminal අයිකන් 4) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/subMenuBarCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#1A2B2E"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/connectionStatusCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp">

            <!-- Lights අයිකනය (සුදු පාට tint එක එකතු කර ඇත) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="#0D1C1E"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lights"
                    android:scaleType="fitCenter"
                    android:contentDescription="Lights"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Vehicle අයිකනය (සුදු පාට tint එක එකතු කර ඇත) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="#0D1C1E"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_vehicle"
                    android:scaleType="fitCenter"
                    android:contentDescription="Vehicle"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Robot අයිකනය (සුදු පාට tint එක එකතු කර ඇත) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="#0D1C1E"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_robot"
                    android:scaleType="fitCenter"
                    android:contentDescription="Robot"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Terminal අයිකනය (සුදු පාට tint එක එකතු කර ඇත) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="#0D1C1E"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_terminal"
                    android:scaleType="fitCenter"
                    android:contentDescription="Terminal"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- වාහන (Truck සහ Car) පෙන්වන කොටස -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/subMenuBarCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Truck එකේ කාඩ් එක -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#111F22"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="30dp"
                    android:src="@drawable/img_truck"
                    android:scaleType="fitCenter"
                    android:contentDescription="Truck Image" />
            </androidx.cardview.widget.CardView>

            <!-- Car එකේ කාඩ් එක -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="80dp"
                app:cardBackgroundColor="#111F22"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="30dp"
                    android:src="@drawable/img_car"
                    android:scaleType="fitCenter"
                    android:contentDescription="Car Image" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>