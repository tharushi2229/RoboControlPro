<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121e1f"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- අලුත් Back Button Header එක -->
    <LinearLayout
        android:id="@+id/btnBackContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/btnBackIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#17C3B2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Menu"
            android:textColor="#17C3B2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- පළමු කොටස: LED Control -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A2B2E"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 LED Control"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#FFFFFF"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="#2E4A4D" android:layout_marginEnd="12dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LED 01" android:textColor="#CCCCCC"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LED1" android:textColor="#17C3B2" android:textSize="14sp" android:textStyle="bold" android:layout_marginEnd="16dp"/>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchLed1" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="#2E4A4D" android:layout_marginEnd="12dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LED 02" android:textColor="#CCCCCC"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LED2" android:textColor="#17C3B2" android:textSize="14sp" android:textStyle="bold" android:layout_marginEnd="16dp"/>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchLed2" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="#2E4A4D" android:layout_marginEnd="12dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LED 03" android:textColor="#CCCCCC"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LED3" android:textColor="#17C3B2" android:textSize="14sp" android:textStyle="bold" android:layout_marginEnd="16dp"/>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchLed3" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- දෙවන කොටස: RGB LED Control -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A2B2E"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RGB LED Control"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchRgb" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <SeekBar
                    android:id="@+id/sliderBrightness"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:rotation="270"
                    android:layout_marginEnd="-40dp"/>

                <!-- මෙතනට ඔයාගේ color wheel පින්තූරය දාන්න -->
                <ImageView
                    android:id="@+id/imgColorWheel"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:src="@drawable/icon_learning"
                    android:layout_marginStart="20dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>